---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title,
  description = 'ZAtlas 的知识分享：教程、技术文章与踩坑记录。',
  type = 'website',
  publishedTime,
} = Astro.props;

const siteTitle = 'ZAtlas';
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const site = Astro.site ?? new URL('https://zatlas.vercel.app');
const canonical = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="ZAtlas" href="/rss.xml" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var mode = stored === 'dark' || stored === 'light' || stored === 'auto' ? stored : 'light';
          var dark =
            mode === 'dark' ||
            (mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          var root = document.documentElement;
          root.dataset.theme = dark ? 'dark' : 'light';
          root.dataset.themeMode = mode;
          root.style.colorScheme = dark ? 'dark' : 'light';
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
